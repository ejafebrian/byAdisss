{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user document storing explicit admin flag and role in Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified user email address",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "editor", "user"],
          "description": "User authorization role"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Explicit boolean admin flag checked by application and rules"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the account is active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "isAdmin", "isActive", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized Firebase admin record mirrored for Firestore security rule verification.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified admin email address",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "editor"],
          "description": "Admin authorization role"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Explicit boolean admin flag"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the admin account is active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "isAdmin", "isActive", "createdAt", "updatedAt"]
    },
    "AdminInvite": {
      "title": "AdminInvite",
      "description": "Email-keyed admin authorization record created by a Super Admin so newly invited admins can automatically claim isAdmin and role in Firestore on login.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Normalized lowercase email address of the authorized admin",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Display name for the invited admin",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "editor"],
          "description": "Assigned admin role"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Must be true for authorized admin invites"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the invite is active"
        },
        "createdByUid": {
          "type": "string",
          "description": "Firebase UID of the Super Admin who created or synced the invite",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "displayName", "role", "isAdmin", "isActive", "createdByUid", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile documents with explicit role and isAdmin flag."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Firestore RBAC registry keyed by Firebase UID for admin authorization checks."
    },
    "/admin_invites/{inviteId}": {
      "schema": { "$ref": "#/entities/AdminInvite" },
      "description": "Super-admin managed email authorization registry enabling newly added admins to upgrade their Firestore user document on sign-in."
    }
  }
}
