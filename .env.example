# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL connection environment variables (injected at runtime)
SQL_HOST="MY_SQL_HOST"
SQL_DB_NAME="MY_SQL_DB_NAME"
SQL_USER="MY_SQL_USER"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_ADMIN_USER="MY_SQL_ADMIN_USER"
SQL_ADMIN_PASSWORD="MY_SQL_ADMIN_PASSWORD"

# Optional connection string alternative for external/Vercel deployments:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Optional comma-separated initial super-admin emails
ADMIN_OWNER_EMAIL="ejafebriansyah3@gmail.com"
