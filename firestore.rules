rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny all paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwnerBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'ejafebriansyah3@gmail.com';
    }

    function hasAdminDoc(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid)) &&
        get(/databases/$(database)/documents/admins/$(uid)).data.isActive == true &&
        get(/databases/$(database)/documents/admins/$(uid)).data.isAdmin == true &&
        get(/databases/$(database)/documents/admins/$(uid)).data.role in ['super_admin', 'admin', 'editor'];
    }

    function hasAdminUserFlag(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.isActive == true &&
        get(/databases/$(database)/documents/users/$(uid)).data.isAdmin == true &&
        get(/databases/$(database)/documents/users/$(uid)).data.role in ['super_admin', 'admin', 'editor'];
    }

    function isAdmin() {
      return isOwnerBootstrapAdmin() || (
        isSignedIn() && (hasAdminDoc(request.auth.uid) || hasAdminUserFlag(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isOwnerBootstrapAdmin() || (
        isSignedIn() && (
          (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true &&
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin'
          ) ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
          )
        )
      );
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'isAdmin', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'isAdmin', 'isActive', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == userId &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        data.role is string &&
        data.role in ['super_admin', 'admin', 'editor', 'user'] &&
        data.isAdmin is bool &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'isAdmin', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'isAdmin', 'isActive', 'createdAt', 'updatedAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == adminUid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.role is string &&
        data.role in ['super_admin', 'admin', 'editor'] &&
        data.isAdmin == true &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (isOwnerBootstrapAdmin() || existing().uid == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isSuperAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().role == 'user' &&
            incoming().isAdmin == false &&
            incoming().isActive == true
          )
        );
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            isSuperAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'role', 'isAdmin', 'isActive', 'updatedAt'])
          ) ||
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().isAdmin == existing().isAdmin &&
            incoming().isActive == existing().isActive &&
            incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(userId) && isSuperAdmin() && userId != request.auth.uid;
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isSignedIn() && (isOwnerBootstrapAdmin() || existing().uid == request.auth.uid);
      allow create: if isSignedIn() &&
        isValidId(adminUid) &&
        isValidAdminRecord(incoming(), adminUid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isSuperAdmin();
      allow update: if isSignedIn() &&
        isValidId(adminUid) &&
        isValidAdminRecord(incoming(), adminUid) &&
        isSuperAdmin() &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role', 'isAdmin', 'isActive', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(adminUid) && isSuperAdmin() && adminUid != request.auth.uid;
    }
  }
}
