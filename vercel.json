{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{firebase-applet-config.json,api/_app.mjs}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/go/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/l/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|go/|l/|assets/|src/assets/|favicon\\.ico|.*\\.[a-zA-Z0-9]{2,8}$).*)",
      "destination": "/index.html"
    }
  ]
}
