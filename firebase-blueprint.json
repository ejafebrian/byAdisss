{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized Firebase admin record mirrored for Firestore security rule verification.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified admin email address",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "editor"],
          "description": "Admin authorization role"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the admin account is active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "isActive", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Firestore RBAC registry keyed by Firebase UID for admin authorization checks."
    }
  }
}
